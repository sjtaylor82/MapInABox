{
  "name": "mapinabox",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  // The site itself. Requests under /api/ go to the Worker first.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // The menu search Worker (holds the Serper key), called directly: one
  // Worker cannot fetch another's workers.dev address.
  "services": [{ "binding": "MENU_SEARCH", "service": "miab-menu-search" }],
  // Served from our own domain rather than *.workers.dev, which many school
  // filters block. (mapinabox.miab.workers.dev keeps working too.)
  "workers_dev": true,
  "routes": [
    { "pattern": "mapinabox.org", "custom_domain": true },
    { "pattern": "www.mapinabox.org", "custom_domain": true },
    // The full app, with Expert mode. Schools block this address; mapinabox.org is Starter only.
    { "pattern": "expert.mapinabox.org", "custom_domain": true }
  ]
}
